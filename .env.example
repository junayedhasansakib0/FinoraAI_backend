# Finora AI — API configuration
# Variable names mirror ARCHITECTURE.md §11. Copy this file to .env and fill in values.
# NEVER commit .env. NEVER let any of these values reach the client bundle.

# ─── Runtime (required now) ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated allowlist of browser origins allowed to send credentials.
CLIENT_ORIGIN=http://localhost:5173

# ─── Database — required from Phase 2 ──────────────────────────────────────────
# DATABASE_URL is the pooled connection the running server uses (Supabase transaction
# pooler, port 6543). DIRECT_URL is the session/direct connection used by migrations
# (port 5432); it falls back to DATABASE_URL when unset.
# Use the IPv4-capable pooler hosts from Supabase → Connect: the legacy
# db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=
DIRECT_URL=

# Development seed only (npm run db:seed). No default password is shipped.
SEED_DEMO_EMAIL=demo@finora.local
SEED_DEMO_PASSWORD=

# ─── Authentication — required from Phase 3 ────────────────────────────────────
# Two different random secrets, at least 32 bytes each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ─── AI providers — required from Phase 10 ─────────────────────────────────────
# Gemini is primary; Groq and OpenRouter are optional fallbacks.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Per-user AI quotas (optional; defaults are applied when unset).
AI_HOURLY_LIMIT=15
AI_DAILY_LIMIT=50

# ─── Market data — from Phase 9 ────────────────────────────────────────────────
# CoinGecko demo key (optional — the free endpoints work without one).
# Frankfurter (FX) needs no key.
COINGECKO_API_KEY=

# Not wired. CoinMarketCap is not in the approved provider list
# (PROJECT_CONTEXT.md §6); its free Basic plan restricts commercial use, so the
# terms must be verified and the docs updated in Phase 9 before it is used.
# COINMARKETCAP_API_KEY=
